{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src/**/*.mjs", "src/**/*.js", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "src/chat.js",
    "src/admin.js",
    "src/client/admin/vendor",
    "src/client/chat/vendor"
  ]
}
